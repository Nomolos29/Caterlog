{
  "name": "caterlog",
  "version": "0.1.0",
  "private": true,
  "description": "Commerce Infrastructure for Chat-First African Vendors",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --experimental-strip-types --watch apps/api/src/server.ts",
    "check:env": "node --experimental-strip-types scripts/check-env.ts",
    "dev:dashboard": "npm --workspace=@caterlog/dashboard run dev",
    "start": "node --experimental-strip-types apps/api/src/server.ts",
    "start:dashboard": "npm --workspace=@caterlog/dashboard run start",
    "build": "npm run build --workspaces --if-present",
    "test": "node --experimental-strip-types --test packages/commerce-core/src/commerce-core.test.ts packages/integrations/src/integrations.test.ts apps/api/src/api.test.ts apps/api/src/security.test.ts apps/api/src/persistence.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm --workspace=@caterlog/database run db:generate",
    "db:push": "node scripts/with-env.mjs npm --workspace=@caterlog/database run db:push",
    "db:migrate": "node scripts/with-env.mjs npm --workspace=@caterlog/database run db:migrate",
    "db:deploy": "node scripts/with-env.mjs npm --workspace=@caterlog/database run db:deploy",
    "db:seed": "node scripts/with-env.mjs npm --workspace=@caterlog/database run db:seed"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-presigned-post": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "@neon/realtime-react": "^0.2.0",
    "dotenv": "^18.0.9",
    "files-sdk": "^3.1.3",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  }
}
