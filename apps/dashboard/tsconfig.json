{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@caterlog/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@caterlog/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@caterlog/storefront-blocks": [
        "../../packages/storefront-blocks/src/index.ts"
      ],
      "@caterlog/storefront-blocks/*": [
        "../../packages/storefront-blocks/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/storefront-blocks/src/**/*.ts",
    "../../packages/storefront-blocks/src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
