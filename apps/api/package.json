    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-presigned-post": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@caterlog/commerce-core": "*",
    "@caterlog/database": "*",
    "@caterlog/integrations": "*",
    "@caterlog/shared": "*",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "@types/pg": "^8.23.1",
    "bullmq": "^6.7.0",
    "dotenv": "^18.0.9",
    "files-sdk": "^3.1.3",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
