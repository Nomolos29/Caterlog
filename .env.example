# Database (PostgreSQL)
DATABASE_URL="postgresql://caterlog:caterlog_dev_password@localhost:5432/caterlog?schema=public"

# Redis (BullMQ Queues, Co-Pilot Idle Timers & Magic Links)
REDIS_URL="redis://localhost:6379"

# API & Dashboard URLs
API_PORT=4000
API_BASE_URL="http://localhost:4000"
DASHBOARD_URL="http://localhost:3000"
JWT_SECRET="caterlog-dev-secret-change-in-production"

# Monnify Integration (Set MONNIFY_SANDBOX_MOCK=true for local simulation without live keys)
MONNIFY_SANDBOX_MOCK="true"
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_API_KEY="MK_TEST_PLACEHOLDER"
MONNIFY_SECRET_KEY="SK_TEST_PLACEHOLDER"
MONNIFY_CONTRACT_CODE="1234567890"

# WhatsApp Cloud API (Set WHATSAPP_SANDBOX_MOCK=true for local simulation)
WHATSAPP_SANDBOX_MOCK="true"
WHATSAPP_VERIFY_TOKEN="caterlog-whatsapp-verify-token"
WHATSAPP_APP_SECRET="whatsapp-app-secret-placeholder"
WHATSAPP_ACCESS_TOKEN="EAAG_PLACEHOLDER"
WHATSAPP_PHONE_NUMBER_ID="100000000000000"

