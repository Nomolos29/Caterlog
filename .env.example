# Database (PostgreSQL)
# DATA_MODE=memory keeps the zero-setup in-process demo. DATA_MODE=database
# hydrates the API from PostgreSQL and write-throughs every mutation via Prisma.
DATA_MODE="memory"
DATABASE_URL="postgresql://caterlog:caterlog_dev_password@localhost:5432/caterlog?schema=public"
# Vendor loaded when DATA_MODE=database (must match a seeded Vendor.slug)
PERSISTENCE_VENDOR_SLUG="amaka-shoes"

# Redis (BullMQ Queues, Co-Pilot Idle Timers & Magic Links)
REDIS_URL="redis://localhost:6379"

# API & Dashboard URLs
API_PORT=4000
API_BASE_URL="http://localhost:4000"
DASHBOARD_URL="http://localhost:3000"
# Baked into the Next.js dashboard at build time. Next.js loads env files from
# apps/dashboard, so set this in apps/dashboard/.env.local for overrides.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
JWT_SECRET="caterlog-dev-secret-change-in-production"

# Monnify Integration
# MONNIFY_MODE: "mock" (no network), "sandbox" (real test API), or "live" (production).
# The legacy MONNIFY_SANDBOX_MOCK flag is still honoured when MONNIFY_MODE is unset.
MONNIFY_MODE="mock"
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_API_KEY="MK_TEST_PLACEHOLDER"
MONNIFY_SECRET_KEY="SK_TEST_PLACEHOLDER"
MONNIFY_CONTRACT_CODE="1234567890"
MONNIFY_TIMEOUT_MS=15000
# Optional checkout redirect + accepted methods (comma-separated)
# MONNIFY_REDIRECT_URL="https://your-dashboard.example/orders"
# MONNIFY_PAYMENT_METHODS="CARD,ACCOUNT_TRANSFER"

# WhatsApp Cloud API
# WHATSAPP_MODE: "mock" (in-memory outbox) or "live" (Meta Graph API).
# The legacy WHATSAPP_SANDBOX_MOCK flag is still honoured when WHATSAPP_MODE is unset.
WHATSAPP_MODE="mock"
WHATSAPP_VERIFY_TOKEN="caterlog-whatsapp-verify-token"
WHATSAPP_APP_SECRET="whatsapp-app-secret-placeholder"
WHATSAPP_ACCESS_TOKEN="EAAG_PLACEHOLDER"
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_GRAPH_API_VERSION="v21.0"

# WhatsApp Business Catalog sync
# WHATSAPP_CATALOG_MODE: "mock" (in-memory catalog) or "live" (Meta Commerce API).
# Mirrors WHATSAPP_MODE when unset.
WHATSAPP_CATALOG_MODE="mock"
WHATSAPP_CATALOG_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_CATALOG_TIMEOUT_MS=15000
# Optional public product URL prefix used in catalog Product Detail Pages
# CATALOG_PRODUCT_URL_BASE="https://shop.caterlog.store/p"

# Your personal WhatsApp phone number for vendor keyword testing (+234...)
VENDOR_WHATSAPP_PHONE="+2348101123098"

