generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum CopilotMode {
  COPILOT    // Waits `copilotIdleSeconds` (default 60s) for vendor reply before auto-responding
  FULL_AUTO  // Responds immediately (<2s) to buyer product inquiries
  MANUAL     // Only generates invoices when explicitly triggered by vendor
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum SalesChannel {
  WHATSAPP_CHAT
  WHATSAPP_STATUS
  WHATSAPP_CATALOG
  INSTAGRAM_DM
  WEB_STOREFRONT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT  // Virtual account generated, stock reserved (default 15m TTL)
  PARTIALLY_PAID   // Buyer transferred less than totalAmountKobo
  PAID             // Full payment verified via Monnify server-to-server check
  PROCESSING       // Vendor is packing order
  OUT_FOR_DELIVERY // Handed to dispatch rider
  FULFILLED        // Delivered & completed
  EXPIRED          // Payment window elapsed without transfer; stock released
  CANCELLED        // Cancelled by vendor or buyer
  REFUNDED
}

enum DiscountType {
  PERCENTAGE // Stored in basis points: 1000 = 10.00%
  FLAT_KOBO  // Stored in kobo: 200000 = ₦2,000.00
}

// ---------------------------------------------------------
// 1. VENDOR & COMPLIANCE
// ---------------------------------------------------------

model Vendor {
  id                     String             @id @default(uuid()) @db.Uuid
  slug                   String             @unique
  businessName           String
  role                   String             @default("reseller") // "reseller" | "supplier"
  whatsappPhone          String             @unique
  whatsappPhoneId        String?            @unique
  wabaId                 String?
  metaCatalogId          String?

  // Configurable Co-Pilot & Stock Reservation Settings
  copilotMode            CopilotMode        @default(FULL_AUTO)
  copilotIdleSeconds     Int                @default(60)
  reservationTtlMinutes  Int                @default(15)

  // Settlement & Monnify Subaccount
  settlementBankCode     String?
  settlementBankName     String?
  settlementAccountNum   String?
  settlementAccountName  String?
  monnifySubAccountCode  String?            @unique

  // Stage 2 Hook: Identity & Trust Badge
  verificationStatus     VerificationStatus @default(UNVERIFIED)
  kycIdentityHash        String?            @unique
  cacNumber              String?
  tinNumber              String?
  instagramHandle        String?
  baseState              String?            @default("Lagos")
  baseCity               String?            @default("Ikeja")
  verifiedAt             DateTime?

  // Stage 3 Hook: Storefront Theme Manifest
  storefrontConfig       Json?

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  consents               VendorConsent[]
  products               Product[]
  shippingZones          ShippingZone[]
  discounts              Discount[]
  customers              Customer[]
  orders                 Order[]
  chatSessions           ChatSession[]
  chatMessages           ChatMessage[]
  commerceEvents         CommerceEvent[]
  mediaAssets            MediaAsset[]
  otpVerifications       OtpVerification[]
  authSessions           VendorAuthSession[]
  marketBoostListing     MarketBoostListing?
  supplierProfile        SupplierProfile?
  resellerMirrors        ResellerCatalogMirror[]
  paymentLinks           PaymentLink[]
  payoutWithdrawals      PayoutWithdrawal[]
  settlementSplitRules   SettlementSplitRule[]
  kycSubmissions         VendorKycSubmission[]
  teamMembers            TeamMember[]
  notifications          VendorNotification[]
  orderRefunds           OrderRefund[]

  @@index([whatsappPhone])
}

model VendorConsent {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @db.Uuid
  consentType   String   // "TERMS_AND_NDPR", "KYC_VERIFICATION", "LENDER_DATA_SHARING"
  policyVersion String   // e.g. "v1.0"
  granted       Boolean
  channel       String   // "WHATSAPP" or "WEB_DASHBOARD"
  ipOrPhoneRef  String
  createdAt     DateTime @default(now())

  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, consentType])
}

// ---------------------------------------------------------
// 2. CATALOG, INVENTORY & STATUS IMAGE MATCHING
// ---------------------------------------------------------

model Product {
  id              String             @id @default(uuid()) @db.Uuid
  vendorId        String             @db.Uuid
  skuCode         String             // Vendor-scoped short code e.g. "SHOE-01"
  name            String
  description     String?
  category        String?            // "fashion", "food", "cosmetics", etc.
  basePriceKobo   BigInt
  compareAtKobo   BigInt?
  isActive        Boolean            @default(true)

  // Media & WhatsApp Status Perceptual Hash (pHash)
  primaryImageUrl String
  imageGallery    Json               @default("[]")
  imagePhash      String?            // 64-bit hex perceptual hash for matching WhatsApp Status replies
  customFields    Json?

  // Atomic stock counters
  stockTotal      Int                @default(0)
  stockReserved   Int                @default(0)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  vendor          Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  orderItems      OrderItem[]
  reservations    StockReservation[]

  @@unique([vendorId, skuCode])
  @@index([vendorId, isActive])
  @@index([vendorId, imagePhash])
}

model ProductVariant {
  id            String             @id @default(uuid()) @db.Uuid
  productId     String             @db.Uuid
  name          String             // e.g. "Size 39 / Black"
  skuSuffix     String             // e.g. "39-BLK"
  priceKobo     BigInt?            // Overrides Product.basePriceKobo if set
  stockTotal    Int                @default(0)
  stockReserved Int                @default(0)

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  reservations  StockReservation[]

  @@unique([productId, skuSuffix])
}

// ---------------------------------------------------------
// 3. SHIPPING ZONES & DISCOUNTS
// ---------------------------------------------------------

model ShippingZone {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @db.Uuid
  code          Int      // 1-based short index for WhatsApp keyword deletion (`shipping delete 2`)
  name          String   // e.g. "Lagos Mainland", "Lekki Phase 1", "Pickup"
  feeKobo       BigInt   // e.g. 250000 (₦2,500)
  estimatedDays String?  // e.g. "Same day" or "1-2 days"
  isActive      Boolean  @default(true)

  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([vendorId, name])
  @@index([vendorId, isActive])
}

model Discount {
  id               String       @id @default(uuid()) @db.Uuid
  vendorId         String       @db.Uuid
  code             String       // Uppercase e.g. "PAYDAY10"
  type             DiscountType
  value            BigInt       // If PERCENTAGE: basis points (1000 = 10%). If FLAT_KOBO: kobo amount
  minOrderKobo     BigInt       @default(0)
  maxUses          Int?
  usedCount        Int          @default(0)
  startsAt         DateTime     @default(now())
  expiresAt        DateTime?
  isActive         Boolean      @default(true)

  vendor           Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([vendorId, code])
  @@index([vendorId, isActive])
}

// ---------------------------------------------------------
// 4. CUSTOMERS, ORDERS & STOCK RESERVATIONS
// ---------------------------------------------------------

model Customer {
  id                String    @id @default(uuid()) @db.Uuid
  vendorId          String    @db.Uuid
  whatsappPhone     String
  name              String?
  defaultAddress    String?
  defaultZoneId     String?   @db.Uuid
  totalOrdersCount  Int       @default(0)
  lifetimeSpendKobo BigInt    @default(0)
  firstSeenAt       DateTime  @default(now())
  lastOrderAt       DateTime?

  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders            Order[]

  @@unique([vendorId, whatsappPhone])
}

model Order {
  id                  String             @id @default(uuid()) @db.Uuid
  vendorId            String             @db.Uuid
  customerId          String             @db.Uuid
  shortCode           String             // Human-friendly e.g. "ORD-882"
  channel             SalesChannel       @default(WHATSAPP_CHAT)
  status              OrderStatus        @default(PENDING_PAYMENT)

  // Financial Breakdown (All in Kobo)
  subtotalKobo        BigInt
  shippingZoneId      String?            @db.Uuid
  shippingFeeKobo     BigInt             @default(0)
  discountId          String?            @db.Uuid
  discountCode        String?
  discountAmountKobo  BigInt             @default(0)
  totalAmountKobo     BigInt             // subtotal + shippingFee - discountAmount
  amountPaidKobo      BigInt             @default(0)
  overpaidAmountKobo  BigInt             @default(0)
  reservationReleased Boolean            @default(false)

  // Delivery Metadata
  deliveryAddress       String?
  deliveryLandmark      String?
  alternatePhone        String?
  riderName             String?
  riderPhone            String?

  // Payment & Refund Metadata
  paymentTransactionRef String?
  refundReference       String?
  refundedAmountKobo    BigInt?
  refundReason          String?
  refundedAt            DateTime?

  // Timestamps
  paymentExpiresAt    DateTime?
  paidAt              DateTime?
  dispatchedAt        DateTime?
  fulfilledAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  vendor              Vendor             @relation(fields: [vendorId], references: [id])
  customer            Customer           @relation(fields: [customerId], references: [id])
  shippingZone        ShippingZone?      @relation(fields: [shippingZoneId], references: [id])
  discount            Discount?          @relation(fields: [discountId], references: [id])
  items               OrderItem[]
  reservations        StockReservation[]
  invoices            PaymentInvoice[]
  refunds             OrderRefund[]

  @@unique([vendorId, shortCode])
  @@index([vendorId, status, createdAt])
}

model OrderItem {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @db.Uuid
  productId       String          @db.Uuid
  variantId       String?         @db.Uuid
  productNameSnap String
  variantNameSnap String?
  quantity        Int
  unitPriceKobo   BigInt
  lineTotalKobo   BigInt

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
}

model StockReservation {
  id         String          @id @default(uuid()) @db.Uuid
  orderId    String          @db.Uuid
  productId  String          @db.Uuid
  variantId  String?         @db.Uuid
  quantity   Int
  status     String          @default("ACTIVE") // "ACTIVE", "CONSUMED", "RELEASED"
  expiresAt  DateTime
  createdAt  DateTime        @default(now())

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([status, expiresAt])
}

// ---------------------------------------------------------
// 5. MONNIFY VIRTUAL ACCOUNTS & SERVER-VERIFIED PAYMENTS
// ---------------------------------------------------------

model PaymentInvoice {
  id                  String               @id @default(uuid()) @db.Uuid
  orderId             String               @db.Uuid
  provider            String               @default("MONNIFY")
  invoiceReference    String               @unique
  expectedAmountKobo  BigInt

  // Dynamic Virtual Account Details rendered in WhatsApp
  accountNumber       String               // 10-digit NUBAN e.g. "8092341102"
  bankName            String               // e.g. "Moniepoint MFB"
  accountName         String               // e.g. "CATERLOG / AMAKA SHOES"
  checkoutUrl         String?

  status              String               @default("ACTIVE") // "ACTIVE", "PAID", "EXPIRED"
  expiresAt           DateTime
  createdAt           DateTime             @default(now())

  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions        PaymentTransaction[]

  @@index([accountNumber, status])
}

model PaymentTransaction {
  id                     String         @id @default(uuid()) @db.Uuid
  invoiceId              String         @db.Uuid
  providerTransactionRef String         @unique
  paymentReference       String
  amountPaidKobo         BigInt
  settlementAmountKobo   BigInt?
  payerName              String?
  payerBankName          String?
  paymentMethod          String         // "ACCOUNT_TRANSFER", "CARD"

  // Principle 10.2: Server-to-Server Verification Proof
  webhookSignatureValid  Boolean        @default(false)
  serverVerifiedAt       DateTime
  rawVerificationJson    Json

  createdAt              DateTime       @default(now())

  invoice                PaymentInvoice @relation(fields: [invoiceId], references: [id])
}

// ---------------------------------------------------------
// 6. SMART CO-PILOT SESSION & AUDIT LEDGER
// ---------------------------------------------------------

model ChatSession {
  id                    String        @id @default(uuid()) @db.Uuid
  vendorId              String        @db.Uuid
  buyerWhatsappPhone    String
  buyerName             String?
  copilotPaused         Boolean       @default(false)
  lastVendorMessageAt   DateTime?
  lastBuyerMessageAt    DateTime?
  activeProductId       String?       @db.Uuid
  activeVariantId       String?       @db.Uuid
  activeOrderId         String?       @db.Uuid
  quantity              Int?
  discountCode          String?
  cartItems             Json?         // Active multi-item shopping cart array
  conversationState     String        @default("IDLE")
  assistanceInquiry     String?
  assistanceRequestedAt DateTime?
  updatedAt             DateTime      @updatedAt

  vendor                Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  messages              ChatMessage[]

  @@unique([vendorId, buyerWhatsappPhone])
}

model ChatMessage {
  id            String       @id @default(uuid()) @db.Uuid
  vendorId      String       @db.Uuid
  chatSessionId String?      @db.Uuid
  channel       String       @default("BUYER_SHOP_WA") // "VENDOR_ADMIN_WA" | "BUYER_SHOP_WA"
  sender        String       // "VENDOR" | "BUYER" | "CATERLOG_BOT"
  fromPhone     String
  text          String
  imageUrl      String?
  quickReplies  Json?
  createdAt     DateTime     @default(now())

  vendor        Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([chatSessionId, createdAt])
}

model CommerceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @db.Uuid
  eventType   String   // "ORDER_CREATED", "PAYMENT_VERIFIED", "STOCK_UPDATED", "DISCOUNT_APPLIED", "SETTINGS_UPDATED"
  actorType   String   // "VENDOR_WA_KEYWORD", "VENDOR_WEB_DASHBOARD", "COPILOT_AUTO", "WEBHOOK"
  entityType  String   // "ORDER", "PRODUCT", "SHIPPING_ZONE", "DISCOUNT", "VENDOR"
  entityId    String
  payload     Json
  createdAt   DateTime @default(now())

  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, eventType, createdAt])
}

// ---------------------------------------------------------
// 7. MEDIA ASSETS & OBJECT STORAGE METADATA
// ---------------------------------------------------------

model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  mediaId     String   @unique // External/Meta media ID or generated UUID
  vendorId    String?  @db.Uuid
  storageKey  String   // Key inside Neon Object Storage bucket ("assets")
  bucket      String   @default("assets")
  contentType String
  sizeBytes   Int
  phash       String   // 64-bit hex perceptual hash for WhatsApp Status matching
  publicUrl   String?
  createdAt   DateTime @default(now())

  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([vendorId, phash])
}

// ---------------------------------------------------------
// 8. WHATSAPP 6-DIGIT OTPs & AUTHENTICATION SESSIONS
// ---------------------------------------------------------

model OtpVerification {
  id          String    @id @default(uuid()) @db.Uuid
  vendorId    String?   @db.Uuid
  phone       String
  code        String    // 6-digit security PIN sent on WhatsApp
  purpose     String    @default("LOGIN") // "LOGIN" | "SIGNUP" | "WITHDRAWAL" | "SETTINGS"
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, expiresAt])
}

model VendorAuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  vendorId    String    @db.Uuid
  token       String    @unique
  email       String?
  phone       String?
  userAgent   String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, expiresAt])
}

// ---------------------------------------------------------
// 9. MARKET BOOST & GEOGRAPHIC VISIBILITY (INTERSTATE COVERAGE)
// ---------------------------------------------------------

model MarketBoostListing {
  id                String   @id @default(uuid()) @db.Uuid
  vendorId          String   @unique @db.Uuid
  isPublished       Boolean  @default(false)
  businessName      String
  category          String   @default("Fashion & Footwear")
  baseState         String   @default("Lagos")
  baseCity          String   @default("Ikeja")
  shippingScope     String   @default("LOCAL_STATE") // "LOCAL_STATE" | "SELECTED_STATES" | "NATIONWIDE"
  allowInterstate   Boolean  @default(false)
  coveredStates     Json     @default("[\"Lagos\"]") // Array of Nigerian states where catalog can be mirrored
  description       String?
  moq               String   @default("1 unit")
  startingPriceKobo BigInt   @default(300000)
  fulfillmentMethod String   @default("Pickup or merchant-arranged delivery")
  deliveryNote           String?
  featuredTags           Json     @default("[]")
  mirroredCategories     Json     @default("[]") // Categories where the entire category is mirrored
  mirroredProductSkus    Json     @default("[]") // Specific product SKUs selected for mirroring
  wholesaleDiscountRules Json     @default("[]") // Discount rules by catalog/category/product and all/specific resellers
  subscriptionPlan       String   @default("STARTER") // "STARTER" | "GROWTH" | "ENTERPRISE"
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([isPublished, baseState, shippingScope])
}

// ---------------------------------------------------------
// 10. WHOLESALE SUPPLIER NETWORK & RESELLER CATALOG MIRRORING
// ---------------------------------------------------------

model SupplierProfile {
  id               String                  @id @default(uuid()) @db.Uuid
  vendorId         String?                 @unique @db.Uuid
  slug             String                  @unique
  name             String
  verified         Boolean                 @default(true)
  cacNumber        String?
  category         String
  location         String
  state            String                  @default("Lagos")
  shippingScope    String                  @default("LOCAL_STATE") // "LOCAL_STATE" | "SELECTED_STATES" | "NATIONWIDE"
  allowInterstate  Boolean                 @default(false)
  coveredStates    Json                    @default("[\"Lagos\"]")
  warehouseAddress String?
  phone            String
  whatsapp         String
  rating           Float                   @default(4.9)
  totalFulfilled   Int                     @default(0)
  subAccountCode   String?
  leadTime         String?
  cutoffTime       String?
  wholesaleTerms   Json?
  catalogProducts  Json                    @default("[]")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  vendor           Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  mirrors          ResellerCatalogMirror[]

  @@index([state, shippingScope])
}

model ResellerCatalogMirror {
  id                  String          @id @default(uuid()) @db.Uuid
  resellerVendorId    String          @db.Uuid
  supplierId          String          @db.Uuid
  mirroredProductSkus Json            @default("[]")
  defaultMarkupBps    Int             @default(2000) // 20.00%
  status              String          @default("ACTIVE") // "ACTIVE" | "PAUSED"
  lastSyncedAt        DateTime        @default(now())
  createdAt           DateTime        @default(now())

  resellerVendor      Vendor          @relation(fields: [resellerVendorId], references: [id], onDelete: Cascade)
  supplier            SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([resellerVendorId, supplierId])
}

// ---------------------------------------------------------
// 11. PAYMENT LINKS, PAYOUT WITHDRAWALS, REFUNDS & SPLIT RULES
// ---------------------------------------------------------

model PaymentLink {
  id            String    @id @default(uuid()) @db.Uuid
  vendorId      String    @db.Uuid
  slug          String    @unique
  customerName  String?
  customerPhone String?
  productSku    String?
  description   String?
  amountKobo    BigInt
  checkoutUrl   String
  isActive      Boolean   @default(true)
  timesUsed     Int       @default(0)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, isActive])
}

model PayoutWithdrawal {
  id            String    @id @default(uuid()) @db.Uuid
  vendorId      String    @db.Uuid
  reference     String    @unique // e.g. "WTH-492810"
  amountKobo    BigInt
  feeKobo       BigInt    @default(0)
  netAmountKobo BigInt
  bankCode      String?
  bankName      String
  accountNumber String
  accountName   String?
  status        String    @default("DISPATCHED") // "PENDING" | "DISPATCHED" | "SETTLED" | "FAILED"
  verifiedByOtp Boolean   @default(true)
  createdAt     DateTime  @default(now())
  settledAt     DateTime?

  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model SettlementSplitRule {
  id                     String   @id @default(uuid()) @db.Uuid
  vendorId               String   @db.Uuid
  name                   String
  supplierSubAccountCode String?
  supplierShareBps       Int      @default(8000) // 80.00%
  resellerShareBps       Int      @default(1850) // 18.50%
  platformFeeBps         Int      @default(150)  // 1.50%
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vendor                 Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, isActive])
}

model OrderRefund {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  vendorId          String    @db.Uuid
  refundReference   String    @unique
  providerRefundRef String?
  amountKobo        BigInt
  reason            String?
  status            String    @default("COMPLETED") // "PENDING" | "COMPLETED" | "FAILED"
  restoredStock     Boolean   @default(true)
  initiatedBy       String    @default("VENDOR_DASHBOARD")
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@index([orderId])
}

// ---------------------------------------------------------
// 12. KYC COMPLIANCE, TEAM MEMBERS & NOTIFICATIONS
// ---------------------------------------------------------

model VendorKycSubmission {
  id                  String             @id @default(uuid()) @db.Uuid
  vendorId            String             @db.Uuid
  businessName        String
  cacNumber           String
  tinNumber           String?
  businessAddress     String?
  businessCategory    String?
  bankCode            String
  bankName            String?
  accountNumber       String
  resolvedAccountName String
  whatsappPhone       String?
  instagramHandle     String?
  cacDocumentUploaded Boolean            @default(true)
  idDocumentUploaded  Boolean            @default(true)
  status              VerificationStatus @default(PENDING_REVIEW)
  reviewerNotes       String?
  submittedAt         DateTime           @default(now())
  reviewedAt          DateTime?

  vendor              Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
}

model TeamMember {
  id                 String    @id @default(uuid()) @db.Uuid
  vendorId           String    @db.Uuid
  name               String
  email              String
  phone              String?
  role               String    @default("Store Attendant") // "Owner" | "Store Manager" | "Store Attendant" | "Accountant" | "Dispatch Coordinator"
  status             String    @default("Active") // "Active" | "Invited" | "Suspended"
  canManageOrders    Boolean   @default(true)
  canManageInventory Boolean   @default(true)
  canViewPayouts     Boolean   @default(false)
  canProcessRefunds  Boolean   @default(false)
  canOverrideCopilot Boolean   @default(true)
  lastActiveAt       DateTime?
  invitedAt          DateTime  @default(now())

  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, email])
}

model VendorNotification {
  id              String    @id @default(uuid()) @db.Uuid
  vendorId        String    @db.Uuid
  notificationKey String    // e.g. "notif-paid-ORD-882"
  title           String
  message         String
  category        String    @default("ORDERS") // "ORDERS" | "PAYOUTS" | "INVENTORY" | "COPILOT" | "SYSTEM"
  isRead          Boolean   @default(false)
  isDismissed     Boolean   @default(false)
  linkText        String?
  targetView      String?
  targetRef       String?
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, notificationKey])
  @@index([vendorId, isRead, createdAt])
}

